# ── Breachlight — configuration ─────────────────────────────
# Copy to `.env` and adjust. `.env` is git-ignored.
#
# The app works with NO configuration: the baseline data sources below need
# no API key. HIBP is one OPTIONAL provider, not a requirement.

# ── Ports ────────────────────────────────────────────────────────────
PORT=5174
WEB_PORT=5173

# ── Local storage ────────────────────────────────────────────────────
DATABASE_FILE=./data/scanner.db

# ── Baseline providers (no API key — on by default) ──────────────────
# XposedOrNot: public per-email breach intelligence (api.xposedornot.com)
XPOSEDORNOT_ENABLED=true
# Public breach catalogue from HIBP's unauthenticated /breaches endpoint,
# cached locally and used to enrich breach metadata.
BREACH_CATALOGUE_ENABLED=true
# Password exposure via the HIBP Pwned Passwords k-anonymity range API
# (only a 5-char SHA-1 prefix ever leaves this machine).
PASSWORD_CHECK_ENABLED=true
# Passive HTTPS / security-header inspection of breached services' domains
# (Deep and Maximum scans only). No path probing, no private infrastructure.
DOMAIN_SECURITY_ENABLED=true

# ── Optional authenticated provider ─────────────────────────────────
# Have I Been Pwned "breachedaccount". Improves per-email coverage.
# Get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ── Demo provider (synthetic data — OFF by default) ─────────────────
# When true, adds a clearly-labelled DEMO source so the UI can be explored
# without hitting real services. Its findings are never mixed with real ones.
DEMO_PROVIDER_ENABLED=false

# ── Tuning ──────────────────────────────────────────────────────────
PROVIDER_CONCURRENCY=4
